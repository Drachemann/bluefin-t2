[Desktop Entry]
Type=Application
Name=bluefin-t2 first-run
Comment=Finish setup after the first login
Exec=/usr/libexec/bluefin-t2/first-run
Icon=preferences-system
Terminal=false
NoDisplay=true
OnlyShowIn=GNOME;
X-GNOME-Autostart-enabled=true
# After the initial tour has had a chance to appear, not on top of it.
X-GNOME-Autostart-Delay=20
